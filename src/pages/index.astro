---
import Layout from '../layouts/Layout.astro';

const services = [
  { label: 'Underground Operations',    img: '/images/service-1.jpg' },
  { label: 'Open Pit Mining',           img: '/images/service-2.jpg' },
  { label: 'Exploration Campaigns',     img: '/images/service-3.jpg' },
  { label: 'Community & ESG Stories',   img: '/images/service-4.jpg' },
  { label: 'Corporate Portraits',       img: '/images/service-5.jpg' },
  { label: 'Documentary Series',        img: '/images/service-6.jpg' },
  { label: 'Mining Sites',              img: '/images/service-7.jpg' },
  { label: 'Operations',                img: '/images/service-8.jpg' },
  { label: 'Infrastructure',            img: '/images/service-9.jpg' },
  { label: 'Mining Teams',              img: '/images/service-10.jpg' },
  { label: 'Field Work',                img: '/images/service-11.jpg' },
  { label: 'Site Documentation',        img: '/images/service-12.jpg' },
  { label: 'Mining Operations',         img: '/images/service-13.jpg' },
  { label: 'Production',                img: '/images/service-14.jpg' },
  { label: 'Global Operations',         img: '/images/service-15.jpg' },
];

const skills = [
  {
    icon: '📖',
    title: 'Storytelling',
    desc: 'Narrative development to drive investor communications, sustainability reports, and feature journalism for mining and resources sectors.',
    num: '',
    numLabel: '',
  },
  {
    icon: '📸',
    title: 'Photography',
    desc: 'Editorial, corporate, and documentary photography from surface to 2,000m underground. ISO-certified for underground environments.',
    num: '500+',
    numLabel: 'shoots completed',
  },
  {
    icon: '🎬',
    title: 'Film & Video',
    desc: 'Short-form documentaries, corporate films, investor reels, and social content. Full production from scripting to grade.',
    num: '200+',
    numLabel: 'films produced',
  },
  {
    icon: '✍️',
    title: 'Copywriting',
    desc: 'Technical writing, investor communications, sustainability reports, and feature journalism for mining and resources sectors.',
    num: '12yrs',
    numLabel: 'industry experience',
  },
  {
    icon: '🌍',
    title: 'Global Reach',
    desc: 'Deployed across 4 continents — Africa, Americas, Australasia, and Europe. Logistics, fixers, and local teams arranged.',
    num: '30+',
    numLabel: 'countries worked',
  },
];

const clients = [
  { name: 'BHP',                    img: '/images/bhp.png'                  },
  { name: 'Rio Tinto',              img: '/images/riotinto.png'             },
  { name: 'Codelco',                img: '/images/codelco.png'              },
  { name: 'Teck',                   img: '/images/teck.png'                 },
  { name: 'Antofagasta Minerals',   img: '/images/antofagastaminerals.png'  },
  { name: 'Los Pelambres',          img: '/images/pelambres.png'            },
  { name: 'Marimaca',               img: '/images/marimaca.png'             },
  { name: 'Cenizas',                img: '/images/cenizas.png'              },
  { name: 'Fundación Chile',        img: '/images/fundacionchile.png'       },
  { name: 'Bloomberg',              img: '/images/bloomberg.png'            },
];
---

<Layout>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="hero" id="home">
    <div class="hero__bg"></div>
    <div class="hero__grid"></div>
    <div class="container hero__inner">

      <div class="hero__content">
        <h1 class="hero__title">
          Storytelling<br/>
          for the<br/>
          <em>Mining World</em>
        </h1>

        <p class="hero__desc">
          We embed with mining operations globally to create photography, film, and
          editorial content that connects companies with investors, communities, and
          the world — from underground to boardroom.
        </p>

        <div class="hero__actions">
          <a href="#services" class="btn btn-primary">Our Work</a>
          <a href="#contact"  class="btn btn-outline">Get in Touch</a>
        </div>

        <div class="hero__stats">
          <div style="background: var(--bg-dark); padding: 1.5rem; border: 1px solid var(--border); border-radius: 4px; text-align: center;">
            <div style="font-size: 1.8rem; color: var(--accent); font-weight: 700; margin-bottom: 0.5rem;">+150</div>
            <div style="font-size: 0.9rem; color: var(--muted);">sites visits</div>
          </div>
          <div style="background: var(--bg-dark); padding: 1.5rem; border: 1px solid var(--border); border-radius: 4px; text-align: center;">
            <div style="font-size: 1.8rem; color: var(--accent); font-weight: 700; margin-bottom: 0.5rem;">+100</div>
            <div style="font-size: 0.9rem; color: var(--muted);">CEO interviews</div>
          </div>
          <div style="background: var(--bg-dark); padding: 1.5rem; border: 1px solid var(--border); border-radius: 4px; text-align: center;">
            <div style="font-size: 1.8rem; color: var(--accent); font-weight: 700; margin-bottom: 0.5rem;">+30</div>
            <div style="font-size: 0.9rem; color: var(--muted);">countries</div>
          </div>
          <div style="background: var(--bg-dark); padding: 1.5rem; border: 1px solid var(--border); border-radius: 4px; text-align: center;">
            <div style="font-size: 1.8rem; color: var(--accent); font-weight: 700; margin-bottom: 0.5rem;">+15</div>
            <div style="font-size: 0.9rem; color: var(--muted);">years experience</div>
          </div>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__video-wrap">
          <video poster="https://res.cloudinary.com/deetpuinn/image/upload/v1784714781/portada_reel_1_vpxxsi.png" style="width: 100%; height: auto; border-radius: 8px; display: block; object-fit: cover;" controls>
            <source src="https://res.cloudinary.com/deetpuinn/video/upload/v1784075387/ppppppppOpKOKK_03-07_Final_Cut_MINING_REEL_PaulXMorten_sfcb6r.mp4" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ABOUT
  ═══════════════════════════════════════════ -->
  <section class="section about" id="about">
    <div class="container about__inner">

      <div class="about__left">
        <p class="section-label">Why Work With Us</p>
        <div class="divider"></div>
        <h2 class="section-title">Mining insiders. <br/>World-class storytellers.</h2>
        <p class="about__copy">
          We don't just video and photograph mining and exploration projects — we understand them.
          Our team combines deep technical knowledge of mining operations with award-winning
          photography and film craft.
        </p>
        <p class="about__copy">
          The result? Content that accurately highlights value creation, that is operationally
          credible, and visually outstanding. We create content your team will be proud to share,
          and that your audiences will trust.
        </p>

        <div class="about__values">
          <div class="about__value">Full production: concept to final deliverable</div>
          <div class="about__value">Global logistics and local network</div>
          <div class="about__value">Professional on-site presence</div>
          <div class="about__value">Technical mining knowledge</div>
          <div class="about__value">Narrative architecture</div>
          <div class="about__value">Safety-certified for underground environments</div>
        </div>
      </div>

      <div class="about__cards">

        <!-- Paul -->
        <div class="about__card">
          <div class="about__card-header">
            <div class="about__avatar">
              <img
                src="/images/paul.jpg"
                alt="Paul Harris"
                style="width:100%;height:100%;object-fit:cover;"
                onerror="this.style.display='none';"
              />
              P
            </div>
            <div>
              <h3 class="about__card-name">Paul Harris</h3>
              <p class="about__card-role">Producer / Journalist</p>
            </div>
          </div>
          <p class="about__card-bio">
            Paul has over twenty-eight years' of experience in the mining sector including investor
            relations roles in gold producers and explorers, communications, research and news
            reporting roles. He founded the successful Colombia Gold Symposium in 2016, has written
            for the industry-leading publication Mining Journal since 2015, and has been the anchor
            for Kitco Mining since 2020. Prior to that, he spent five years in Chile reporting and
            analysing the copper sector for CRU and Metal Bulletin. With an expertise in the copper,
            gold and silver sectors in the Americas, he has undertaken dozens of site visits and
            helped many companies improve their corporate and investor communications.
          </p>
          <div class="about__card-tags">
            <span class="about__tag">Investor Relations</span>
            <span class="about__tag">Mining Journal</span>
            <span class="about__tag">Kitco Mining</span>
            <span class="about__tag">Americas</span>
          </div>
        </div>

        <!-- Morten -->
        <div class="about__card">
          <div class="about__card-header">
            <div class="about__avatar">
              <img
                src="/images/morten.png"
                alt="Morten Andersen"
                style="width:100%;height:100%;object-fit:cover;"
                onerror="this.style.display='none';"
              />
              M
            </div>
            <div>
              <h3 class="about__card-name">Morten Andersen</h3>
              <p class="about__card-role">Photographer & Director</p>
            </div>
          </div>
          <p class="about__card-bio">
            Hollywood award-winning photographer and filmmaker Morten Skov Andersen has gained global
            recognition, winning prestigious honors like the Hollywood Documentary Awards for his short
            film The Blind Birdwatcher. His iconic photography includes National Geographic covers,
            infiltrating the Mexican mafia, and documenting cocaine labs in Colombia for The New York
            Times, The Guardian, and GQ. Morten has earned international awards at Lions Cannes,
            Picture of the Year, and FIAB.
          </p>
          <div class="about__card-tags">
            <span class="about__tag">Hollywood Documentary Awards</span>
            <span class="about__tag">National Geographic</span>
            <span class="about__tag">Lions Cannes</span>
            <span class="about__tag">New York Times</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SERVICES / GALLERY
  ═══════════════════════════════════════════ -->
  <section class="section" id="services">
    <div class="container">
      <div class="services__header">
        <p class="section-label">Our Work</p>
        <div class="divider" style="margin-inline:auto;"></div>
        <h2 class="section-title">Stories from the ground up</h2>
        <p class="section-subtitle">
          Every project is unique. We adapt to your environment, brand, and audience to tell your
          story and deliver content that is technically precise and visually compelling.
        </p>
      </div>

      <div class="masonry">
        {services.map((s, i) => (
          <div class="masonry__item">
            <img
              src={s.img}
              alt={s.label}
              class="masonry__img"
              onerror={`this.parentElement.classList.add('placeholder-mode')`}
            />
            <div class="masonry__overlay">
              <span class="masonry__label">{s.label}</span>
            </div>
          </div>
        ))}
      </div>

      <h3 style="font-size: 2rem; margin: 4rem 0 2rem; color: var(--text);">Our Work in Video</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
        <div>
          <h4 style="color: var(--text); margin-bottom: 1rem; font-size: 1.1rem;">Freeport-McMoRan - El Abra</h4>
          <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
            <video poster="https://res.cloudinary.com/deetpuinn/image/upload/v1784693989/portada_el_abra_ydzb8b.png" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" controls>
              <source src="https://res.cloudinary.com/deetpuinn/video/upload/v1784020229/VIDEO_EL_ALBA_30_AN%CC%83OS_13_ENERO_k78zlt.mp4" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
        <div>
          <h4 style="color: var(--text); margin-bottom: 1rem; font-size: 1.1rem;">Teck Mining - Corporate Video</h4>
          <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
            <video poster="https://res.cloudinary.com/deetpuinn/image/upload/v1784693990/portada_teck_mdwwbe.png" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" controls>
              <source src="https://res.cloudinary.com/deetpuinn/video/upload/v1784692799/000video_enrique_castro_completo___12_octubre_1080p_fsc0l9.mp4" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
        <div>
          <h4 style="color: var(--text); margin-bottom: 1rem; font-size: 1.1rem;">Caterpillar - AHS Trucks</h4>
          <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
            <video poster="https://res.cloudinary.com/deetpuinn/image/upload/v1784693989/portada_caterpillar_ekitkf.png" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" controls>
              <source src="https://ik.imagekit.io/vrgtfd8pp/2_AHS%20Trucks%20Caterpillar.mp4" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       EXPERIENCE
  ═══════════════════════════════════════════ -->
  <section class="section experience" id="experience">
    <div class="container">
      <p class="section-label">Expertise</p>
      <div class="divider"></div>
      <h2 class="section-title">What we bring to every project</h2>

      <div class="experience__grid">
        {skills.map(s => (
          <div class="exp__item">
            <div class="exp__content">
              <h3 class="exp__title">{s.title}</h3>
              <p class="exp__desc">{s.desc}</p>
            </div>
            {s.num && (
              <div class="exp__stat">
                <div class="exp__num">{s.num}</div>
                {s.numLabel && <div class="exp__label">{s.numLabel}</div>}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CLIENTS
  ═══════════════════════════════════════════ -->
  <section class="section" id="clients">
    <div class="container">
      <div class="clients__header">
        <p class="section-label">Trusted By</p>
        <div class="divider" style="margin-inline:auto;"></div>
        <h2 class="section-title">The companies behind the world's metals</h2>
        <p class="section-subtitle">
          From junior explorers to tier-one producers, we've worked with companies
          at every stage of the mining lifecycle.
        </p>
      </div>

      <div class="clients__grid">
        {clients.map(c => (
          <div class="client__logo">
            <img src={c.img} alt={c.name} class="client__logo-img" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CONTACT
  ═══════════════════════════════════════════ -->
  <section class="section contact" id="contact">
    <div class="container contact__inner">

      <div>
        <p class="section-label">Get In Touch</p>
        <div class="divider"></div>
        <h2 class="section-title">Let's tell your story</h2>
        <p class="contact__copy">
          Planning a campaign, annual report, investor roadshow, or documentary?
          Tell us about your project and we'll get back to you within 24 hours.
        </p>

        <div class="contact__links">
          <a href="mailto:miningstorytellers@gmail.com" class="contact__link">
            <div class="contact__link-icon">✉️</div>
            <div>
              <div class="contact__link-label">Email us</div>
              <div class="contact__link-value">miningstorytellers@gmail.com</div>
            </div>
          </a>

          <a href="https://linkedin.com/company/miningstorytellers" class="contact__link" target="_blank" rel="noopener">
            <div class="contact__link-icon">in</div>
            <div>
              <div class="contact__link-label">LinkedIn</div>
              <div class="contact__link-value">Mining Storytellers</div>
            </div>
          </a>

          <a href="https://instagram.com/miningstorytellers" class="contact__link" target="_blank" rel="noopener">
            <div class="contact__link-icon">📷</div>
            <div>
              <div class="contact__link-label">Instagram</div>
              <div class="contact__link-value">@miningstorytellers</div>
            </div>
          </a>
        </div>
      </div>

      <div class="contact__form">
        <h3 class="contact__form-title">Send us a message</h3>
        <form name="contact" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="contact" />

          <div class="form__group">
            <label class="form__label" for="name">Full Name</label>
            <input class="form__input" type="text" id="name" name="name" placeholder="Your name" required />
          </div>

          <div class="form__group">
            <label class="form__label" for="email">Email Address</label>
            <input class="form__input" type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>

          <div class="form__group">
            <label class="form__label" for="company">Company / Project</label>
            <input class="form__input" type="text" id="company" name="company" placeholder="Company name" />
          </div>

          <div class="form__group">
            <label class="form__label" for="message">Tell us about your project</label>
            <textarea class="form__textarea" id="message" name="message" placeholder="Location, timeline, deliverables..." required></textarea>
          </div>

          <div style="display:flex;justify-content:center;">
            <button type="submit" class="btn btn-primary" style="min-width:200px;justify-content:center;">
              Send Message
            </button>
          </div>
        </form>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* Masonry placeholder fallback when images missing */
  .masonry__item.placeholder-mode .masonry__img {
    background: var(--bg-card);
    min-height: 220px;
  }

  /* ── YouTube Facade ─────────────────────────────── */
  .yt-facade {
    position: absolute;
    inset: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .yt-facade__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-facade__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    transition: background 0.2s;
  }

  .yt-facade:hover .yt-facade__overlay {
    background: rgba(0, 0, 0, 0.15);
  }

  .yt-facade__play {
    position: relative;
    z-index: 1;
    background: none;
    border: none;
    cursor: pointer;
    width: 72px;
    height: 52px;
    transition: transform 0.2s;
  }

  .yt-facade:hover .yt-facade__play {
    transform: scale(1.1);
  }

  .yt-play-bg {
    fill: #ff0000;
    fill-opacity: 0.9;
    transition: fill-opacity 0.2s;
  }

  .yt-facade:hover .yt-play-bg {
    fill-opacity: 1;
  }

  .yt-play-arrow {
    fill: #fff;
  }

  /* Active iframe replaces facade */
  .hero__video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>

<script>
  const facade = document.getElementById('ytFacade');
  if (facade) {
    facade.addEventListener('click', () => {
      const cloud = facade.dataset.cloud;
      const publicId = facade.dataset.publicid;
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.cloudinary.com/embed/?cloud_name=${cloud}&public_id=${publicId}&autoplay=true`;
      iframe.title = 'Mining Storytellers — Showreel';
      iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      facade.replaceWith(iframe);
    });
  }
</script>
